# Meta Model API (server-side only; never expose to a browser)
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 | muse-wonder-1.0
MODEL_ID=muse-spark-1.3
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Spending safeguards (USD, estimated from published per-token prices)
MODEL_MAX_COST_PER_REQUEST_USD=0.05
MODEL_MAX_SESSION_COST_USD=1.00
MODEL_MAX_OUTPUT_TOKENS=1024

# AgroGenesis simulator (server-to-server agent API; see docs/SIMULATOR_INTEGRATION.md)
SIMULATOR_BASE_URL=http://localhost:3000
# Scoped, per-game agent token issued by the simulator. NOT the administrator password.
SIMULATOR_AGENT_TOKEN=
# Optional: required if the token authorizes more than one game
SIMULATOR_GAME_ID=
SIMULATOR_TIMEOUT_MS=15000

LOG_LEVEL=info
