{
  "name": "agrogenesis-muse-agent",
  "version": "0.1.5",
  "private": true,
  "description": "Meta Muse-powered autonomous agent foundation for the AgroGenesis simulator (hackathon submission).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config",
    "docs/LIBRARY.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "prepare": "npm run build",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "model:ping": "tsx scripts/model-ping.ts",
    "integration:real": "tsx scripts/simulator-integration.ts",
    "agent:observe": "tsx scripts/agent-run.ts observe",
    "agent:test-action": "tsx scripts/agent-run.ts test-action",
    "agent:autonomous": "tsx scripts/agent-autonomous.ts start",
    "agent:resume": "tsx scripts/agent-autonomous.ts resume",
    "agent:status": "tsx scripts/agent-autonomous.ts status",
    "baseline:start": "tsx scripts/agent-baseline.ts start",
    "baseline:resume": "tsx scripts/agent-baseline.ts resume",
    "baseline:status": "tsx scripts/agent-baseline.ts status",
    "benchmark:verify-pair": "tsx scripts/benchmark.ts verify-pair",
    "benchmark:outcome": "tsx scripts/benchmark.ts outcome"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.0.0",
    "pg": "^8.23.1",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
